# Copy to .env.local (never commit .env.local) and also add these in Vercel > Project > Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Public by design (reads the public view, talks to Supabase Auth).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server only. Never prefix with NEXT_PUBLIC_ and never paste it in chat or commit it.
# The secret key (sb_secret_...) or the legacy service_role key. Server only.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
# Secret, server only. Random text, AT LEAST 32 characters (make one with: openssl rand -base64 32).
# Mixed into visitors' IP addresses before hashing (spam limits). In production (NODE_ENV=production) the site REFUSES
# every write (503 not_configured) while this is missing or shorter than 32 characters. Locally it falls back to a dev value.
# MANAGE_CODE_SALT is retired (manage codes no longer exist): you may delete it from Vercel.
IP_HASH_SALT=any-long-random-text-at-least-32-characters
# Required: /api/keepalive answers 401 without it.
CRON_SECRET=any-long-random-text
