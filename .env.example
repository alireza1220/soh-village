# Copy to .env.local (never commit .env.local) and also add these in Vercel > Project > Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Public by design.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server only. Never prefix with NEXT_PUBLIC_ and never paste it in chat or commit it.
# The secret key (sb_secret_...) or the legacy service_role key. Server only.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
# Also at least 32 characters in production (same rule as MANAGE_CODE_SALT).
IP_HASH_SALT=any-long-random-text-at-least-32-characters
# Required: /api/keepalive answers 401 without it.
CRON_SECRET=any-long-random-text
# Secret, server only. Random text, AT LEAST 32 characters (make one with: openssl rand -base64 32).
# Keys the hash of the manage codes people get when they post a listing (HMAC). Set it once and keep it:
# CHANGING IT LATER MAKES ALL EXISTING MANAGE CODES STOP WORKING. In production (NODE_ENV=production) the
# site REFUSES to post or manage listings (503 not_configured) while this is missing or shorter than 32
# characters. Locally it falls back to a dev value.
MANAGE_CODE_SALT=any-long-random-text-at-least-32-characters
